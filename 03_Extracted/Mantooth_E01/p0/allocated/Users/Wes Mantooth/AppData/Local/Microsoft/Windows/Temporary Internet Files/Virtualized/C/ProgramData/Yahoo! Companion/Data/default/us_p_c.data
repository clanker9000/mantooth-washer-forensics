upg,<html><head><link rel="stylesheet" type="text/css" href="http://us.js2.yimg.com/us.js.yimg.com/lib/common/css/reset_2.1.0.css" /><link rel="stylesheet" type="text/css" href="http://us.js1.yimg.com/us.yimg.com/lib/s2/tbupdate_20061205.css" /><script language="javascript">var title = 'Yahoo! Toolbar - Required Upgrade';var mainMessage = 'Upgrade Yahoo! Toolbar now to ensure compatibility with Internet Explorer 7';var btnText = 'Upgrade now';var listHead = 'Plus, the free Yahoo! Toolbar upgrade lets you:';var listItem1 = 'Protect your PC from spyware and other threats';var listItem2 = 'Search the web from anywhere online';var listItem3 = 'Check your Yahoo! Mail, Messenger and more';var noThanks = 'No thanks, remind me later';var binit= false;var ex= window.external;var cv= ex.get('cv',0);function prepTexts(){//Set up parts of the HTML for innerText-ing	gid = document.getElementById;		mm = gid('mainMessage');	sm = gid('subMessage');	upbtn = gid('upgradeButton');	rm = gid('roundMe'); // the grey box with rounded corners	nl = gid('nolink');	rl = gid('remindLink');	ulh = gid('ulhead');	li1 = gid('item1');	li2 = gid('item2');	li3 = gid('item3');}function setTexts(){		mm.innerText = mainMessage;		upbtn.innerText = btnText;		nl.innerText = noThanks;		nl.className = 'c';		rl.className = 'c';		ulh.innerText = listHead;		li1.innerText = listItem1;		li2.innerText = listItem2;		li3.innerText = listItem3;}function resize(){	var ht = document.all.copy.getBoundingClientRect().bottom + parseInt(document.body.bottomMargin);	if (ht < 50){ //we initially hide the footer - if it's hidden, get the height from the mainMessageDiv		ht = document.all.main.getBoundingClientRect().bottom - 70;	}	if(cv <= 50505){		ht += 30;	}	ex.set('height',ht);	var wt = document.all.main.getBoundingClientRect().right + parseInt(document.body.rightMargin);	if(cv <= 50505){		wt += 30;	}	ex.set('width',wt);}function onl(){ if (binit)   return; binit= true; var vc= parseInt(ex.gr(1, 'ycheck', 'lastVChecked')); if ((vc >= 60305) || (cv > 60305))   ex.end(2); else {  ex.sr(1, 'ycheck', 'lastVChecked', '60305');   if (cv >= 60300)    window.location.href= "http://us.update.toolbar.yahoo.com/tip/update.html";  else  {   prepTexts();   setTexts();   resize();   beacon(97726322);  } }}function doI(){  beacon(97726323);  ex.end(1);}function beacon(num){  var r=Math.random();  var beacon= new Image();  beacon.src= "http://pclick.internal.yahoo.com/p/s=" + num + "/lng=us/rand=" + r;}</script></head><body onLoad="onl();"><form action="#"><div class="container" id="container"><div id="mainmessage"></div><div id="submessage"></div><a href="#" id="installB" onClick="doI();" accesskey="I" class="btn"><strong><strong><strong id="upgradeButton"></strong></strong></strong></a><span id="remindLink"><a href="#" id="nolink" onClick="window.external.end(2);" accesskey="R"></a></span><div id="roundMe" class="roundMe"><div class="corner-top"><div class="corner-left"></div></div><div class="bd"><img class="screenshot" src="http://us.i1.yimg.com/us.yimg.com/i/us/tb/br/tb_ng_2.gif" /> <strong class="ulhead" id="ulhead"></strong><ul><li id="item1"></li><li id="item2"></li><li id="item3"></li></ul></div><div class="corner-bottom"><div class="corner-left"></div></div></div></div><center><table border="0" width="100%" cellspacing="0" cellpadding="0" id="header" class="hide"><tr><td width="1%"><a href="http://toolbar.yahoo.com"><img src="http://us.i1.yimg.com/us.yimg.com/i/us/tb/b/tb_ma_02.gif" alt="Yahoo! Toolbar" border="0" width="220" height="30"></a></td><td><hr size="1" noshade></td></tr></table><br><table id="main" border="0" width="400" cellspacing="0" cellpadding="0"><tr></tr><tr><td align="center" id="tdCpnDl" style="display:inline"><table width="100%" align="center"><tr id="trCpnDlImgMsg"><td align="center"><img id="imgCert" style="display:none">