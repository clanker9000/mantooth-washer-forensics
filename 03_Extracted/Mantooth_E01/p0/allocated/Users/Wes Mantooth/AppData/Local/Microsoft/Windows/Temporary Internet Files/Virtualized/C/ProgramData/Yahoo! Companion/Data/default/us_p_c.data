wp,<html><head><meta http-equiv="content-type" content="text/html; charset=ISO-8859-1">	<title>Yahoo! Toolbar is ready to go!</title>	<style>		BODY { padding: 0; margin: 0; background: #F5F3F8 url('http://us.i1.yimg.com/us.yimg.com/i/us/tb/wlcm/wlcm_tb_bg.gif') no-repeat; color: #666; }		BODY, TD{ font-size: 12px; font-family: Arial, Helvetica, Sans-Serif; }		a { color: #663399; }		input { margin: 0 5px 0 0; }		.cap.top { height: 3px; border: solid #6F6C63; border-width: 1px 1px 0 1px; background: #E3E2E7; }		.cap.top div { border-top: 1px solid #ABAAA8; }		.cap.top div div { border-top: 1px solid #BCBBC0; }		.cap.bottom { height: 3px; margin: 0 0 0 0;}		.cap.bottom .step_1 { border: solid #000; border-width: 0 1px; margin: 0 1px; background: #D4D5D9; height: 1px; }		.cap.bottom .step_2 { border: solid #000; border-width: 0 2px; margin: 0 2px; background: #D4D5D9; height: 1px; }		.cap.bottom .step_3 { background: #000; margin: 0 4px; height: 1px; }		#content { padding: 0 15px 12px 15px; padding-top: 23px; border: solid 1px; border-width: 0 1px; }		#header {  padding: 10px 0; margin: 0 0 12px 0; height: 53px; text-align: center; }		h1 { color: #6C0D85; font-weight: normal; font-size: 26px; padding: 0; margin: 0; }		h1 strong { font-weight: bold; }		h2 { position: relative; top: -5px; left: 50px; font-weight: normal; font-size: 17px; margin: 0 0 8px 0; }		h2 strong { font-weight: bold; }		h3 { padding: 0; margin: -1px 0 0 90px; color: #000; font-size: 16px; }		.details ul { font-size: 13px; color: black; margin: 15px 0 13px 107px; padding: 0; }		.buttons { text-align: center; }	</style>	<script language='JScript'>		var beaconPersonalize = '97469591';		var beaconClose = '97469592';		var beaconPV = '97469590';		function getver()		{			var verlong = window.external.get('cv');			var vermajor = (verlong - (verlong%10000))/10000;			var verminor = (verlong - (verlong%100))/100 - (vermajor*100);			var verminor2 = verlong - (vermajor*10000) - (verminor*100);			var version = vermajor + '_' + verminor + '_' + verminor2;			return version;		}		window.external.worker.navsil("http://rd.companion.yahoo.com/slv/clpv/us/wp/"+getver()+"/view/*http://us.i1.yimg.com/us.yimg.com/i/sh/bl.gif");		window.external.set('width',600);		window.external.set('height',305);		var r=Math.random();		window.external.worker.navsil('http://pclick.internal.yahoo.com/p/s=' + beaconPV + '/rand=' + r + '/lng=us');		function personalize()		{			var r=Math.random();			window.external.worker.navsil('http://pclick.internal.yahoo.com/p/s=' + beaconPersonalize + '/rand=' + r + '/lng=us');			window.external.bnav(36,"http://rd.companion.yahoo.com/slv/clpv/us/wp/"+getver()+"/view/lm/*http://us.edit.companion.yahoo.com/config/slv4_edit",0);		}		function close1()		{			var r=Math.random();			window.external.worker.navsil('http://pclick.internal.yahoo.com/p/s=' + beaconClose + '/rand=' + r + '/lng=us');			window.external.worker.navsil("http://rd.companion.yahoo.com/slv/clpv/us/wp/"+getver()+"/view/close/*http://us.i1.yimg.com/us.yimg.com/i/sh/bl.gif");		}	</script></head><body onload="btn_ok.focus();">	<div class="cap top"><div><div><spacer type="block" height="1" width="1" /></div></div></div>	<div id="content">		<div id="header">			<h1><strong>Yahoo! Toolbar</strong> - the Web at your fingertips</h1>		</div>		<h2>			<img src="http://us.i1.yimg.com/us.yimg.com/i/us/tb/wlcm/wlcm_tb_img.gif">		</h2>		<h3>It sits right in your browser.  All you have to do is use it.</h3>		<div class="details">			<ul>				<li>Protect your PC with free Anti-Spy technology</li>				<li>Instantly know when you receive new email</li>				<li>Search from anywhere on the Web</li>				<li>And a <a href="http://toolbar.yahoo.com/config/slv4_page?.p=featureindex" target='features'>whole lot more</a>!</li>			</ul>		</div>		<div class="buttons">			<input type="button" value="Personalize your Toolbar" onclick='personalize();window.external.end(2);return false' />			<input type="button" value="Close" name="btn_ok" id="btn