wp_v6_msgr,<html><head><title>Yahoo! Toolbar is ready to go!</title><style>		BODY { padding: 0; margin: 0; background: #F5F3F8; color: #666; }		BODY, TD{ font-size: 12px; font-family: Arial, Helvetica, Sans-Serif; }		a { color: #663399; }		input { margin: 0 5px 0 0; }		.cap.top { height: 3px; border: solid #6F6C63; border-width: 1px 1px 0 1px; background: #E3E2E7; }		.cap.top div { border-top: 1px solid #ABAAA8; }		.cap.top div div { border-top: 1px solid #BCBBC0; }		.cap.bottom { height: 3px; }		.cap.bottom .step_1 { border: solid #000; border-width: 0 1px; margin: 0 1px; background: #D4D5D9; height: 1px; }		.cap.bottom .step_2 { border: solid #000; border-width: 0 2px; margin: 0 2px; background: #D4D5D9; height: 1px; }		.cap.bottom .step_3 { background: #000; margin: 0 4px; height: 1px; }		#content { padding: 20px 15px 10px 15px; border: #000 solid; border-width: 0 1px; }		#header {  padding: 10px 0; margin: 0 0 12px 0; height: 53px; text-align: center; }		h1 { color: #6C0D85; font-weight: normal; font-size: 26px; padding: 0; margin: 0; }		h1 strong { font-weight: bold; }		h2 { position: relative; top: -15px; left: -10px; font-weight: normal; font-size: 17px; margin: 0 0 0 0; padding: 0; }		h2 strong { font-weight: bold; }		h3 { position: absolute; top: 140px; left: 45px; padding: 0; color: #000; font-size: 16px; }		.details { position: absolute; top: 160px; left: 45px; font-size: 13px; color: black; margin: 20px 0 0 0px; padding: 0; }		.arrow { position: absolute; top: 3px; left: 5px; z-index: -1;}		.buttons { text-align: center;  }</style></head><script language='JScript'>	var beaconPersonalize = '97469594';	var beaconClose = '97469595';	var beaconPV = '97469593';	function getver()	{		var verlong = window.external.get('cv');		var vermajor = (verlong - (verlong%10000))/10000;		var verminor = (verlong - (verlong%100))/100 - (vermajor*100);		var verminor2 = verlong - (vermajor*10000) - (verminor*100);		var version = vermajor + '_' + verminor + '_' + verminor2;		return version;	}	window.external.worker.navsil("http://rd.companion.yahoo.com/slv/clpv/us/wp/"+getver()+"/view/*http://us.i1.yimg.com/us.yimg.com/i/sh/bl.gif");	window.external.set('width',615);	window.external.set('height',305);	var r=Math.random();	window.external.worker.navsil('http://pclick.internal.yahoo.com/p/s=' + beaconPV + '/rand=' + r + '/lng=us');	function personalize()	{		var r=Math.random();		window.external.worker.navsil('http://pclick.internal.yahoo.com/p/s=' + beaconPersonalize + '/rand=' + r + '/lng=us');		window.external.bnav(36,"http://rd.companion.yahoo.com/slv/clpv/us/wp/"+getver()+"/view/lm/*http://us.edit.toolbar.yahoo.com/config/slv4_addbutton?.btn=modmes",0);	}	function close1()	{		var r=Math.random();		window.external.worker.navsil('http://pclick.internal.yahoo.com/p/s=' + beaconClose + '/rand=' + r + '/lng=us');		window.external.worker.navsil("http://rd.companion.yahoo.com/slv/clpv/us/wp/"+getver()+"/view/close/*http://us.i1.yimg.com/us.yimg.com/i/sh/bl.gif");	}</script><body onload="btn_ok.focus();"><div class="cap top"><div><div><spacer type="block" height="1" width="1" /></div></div></div><div id="content"><div id="header"><h1><strong>Yahoo! Toolbar and Messenger</strong> - together at last</h1></div><div class="arrow"><img src="http://us.i1.yimg.com/us.yimg.com/i/us/tb/wlcm/wlcm_msgr_bg.gif"></div><h2><img src="http://us.i1.yimg.com/us.yimg.com/i/us/tb/wlcm/wlcm_msgr_img.gif"></h2><h3><strong>Toolbar sits right in your browser,<br>so you can instantly:</strong></h3><div class="details"><ul><li>Sign in to Messenger</li><li>Change your Messenger status</li><li>IM the page you're viewing to friends</li><li>And a <a href="http://toolbar.yahoo.com/config/slv4_page?.p=featureindex" target='features'>whole lot more</a>!</li></ul></div><div class="buttons"><b>Don't see the Yahoo! Messenger button?</b>  <input type="button" value="Sign in Now" onclick='personalize();window.external.end(2);return false' /><input type="button" value="No Thanks" name="btn_ok" id="btn_ok" onClick='close1();window.external.end(2);return false;'/></div></div><div class="cap bottom"><div class="step_1"><spacer type="block" height="1" width="1" /></div><div class="step_2"><spacer type="block" height="1" width="1" /></div><div class="step_3"><spacer type="block" height="1" width="1" /></div></div></body></html>
