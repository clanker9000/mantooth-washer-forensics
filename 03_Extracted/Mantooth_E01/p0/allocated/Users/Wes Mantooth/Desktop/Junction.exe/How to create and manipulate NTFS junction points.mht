                <TD class=3Dtext>Displays the target of an NTFS junction =

              point</TD></TR>
              <TR>
                <TD class=3Dbullet>=E2=80=A2</TD>
                <TD class=3Dtext>Deletes NTFS junction points that are =
created=20
                  with Linkd.exe</TD></TR>
              <TR>
                <TD class=3Dbullet>=E2=80=A2</TD>
                <TD class=3Dtext>Location: <I>Microsoft Windows 2000 =
Resource=20
                  Kit</I></TD></TR></TBODY></TABLE>
            <H4 id=3DtocHeadRef>Mountvol.exe</H4>
            <SCRIPT type=3Dtext/javascript>loadTOCNode(3, =
'summary');</SCRIPT>

            <TABLE class=3D"list ul">
              <TBODY>
              <TR>
                <TD class=3Dbullet>=E2=80=A2</TD>
                <TD class=3Dtext>Grafts the root folder of a local =
volume onto a=20
                  Windows 2000 version of NTFS folder (or "mounts" the=20
              volume)</TD></TR>
              <TR>
                <TD class=3Dbullet>=E2=80=A2</TD>
                <TD class=3Dtext>Displays the target of an NTFS junction =
point=20
                  that is used to mount a volume</TD></TR>
              <TR>
                <TD class=3Dbullet>=E2=80=A2</TD>
                <TD class=3Dtext>Lists the local file system volumes =
that are=20
                  available for use</TD></TR>
              <TR>
                <TD class=3Dbullet>=E2=80=A2</TD>
                <TD class=3Dtext>Deletes the volume mount points that =
are=20
                  created with mountvol.exe</TD></TR>
              <TR>
                <TD class=3Dbullet>=E2=80=A2</TD>
                <TD class=3Dtext>Location: Windows 2000 CD-ROM in the =
I386=20
                folder</TD></TR></TBODY></TABLE>
