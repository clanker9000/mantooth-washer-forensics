          if (index =3D=3D -1)
          {
            index =3D location.indexOf('?edit=3D');
            editString =3D '?edit=3Dtrue'
          }
          var tempLocation =3D location.substring(0,index);
          var tempLocation2 =3D location.substring(index+1);
          if (tempLocation2.indexOf('&') !=3D -1)
