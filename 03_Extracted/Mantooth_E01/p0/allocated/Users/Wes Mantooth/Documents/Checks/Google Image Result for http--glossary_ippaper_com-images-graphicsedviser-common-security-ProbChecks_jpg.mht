S.substring(S.indexOf('  ')+2)
  }=20
  var i
  while (S.length > 0 && S.charAt(0) <=3D ' ') S =3D S.substring(1);
  while ((i=3DS.length) > 0 && S.charAt(i-1) <=3D ' ') S =3D =
S.substring(0, S.length - 1);
  return S;
}

