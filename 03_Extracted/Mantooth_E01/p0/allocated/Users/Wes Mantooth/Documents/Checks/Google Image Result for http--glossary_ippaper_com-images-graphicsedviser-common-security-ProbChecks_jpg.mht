function normalizeString(s) {
  // this is a simplified normalize space function that replaces any =
newline, carriage returns with spaces,
  //  replaces all continuous multiple spaces occuring in the string to =
a single space, then trims the string.
  var S =3D new String(s);
  while (S.indexOf('\r') > -1) {
    S =3D S.substring(0, S.indexOf('\r')) + ' ' + =
S.substring(S.indexOf('\r')+1)
  }
  while (S.indexOf('\n') > -1) {
    S =3D S.substring(0, S.indexOf('\n')) + ' ' + =
S.substring(S.indexOf('\n')+1)
  }  =20
  while (S.indexOf('  ') > -1) {
