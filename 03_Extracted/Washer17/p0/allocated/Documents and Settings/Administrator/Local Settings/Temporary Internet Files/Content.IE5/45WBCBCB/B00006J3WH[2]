    if(radioObj.checked)
      regId = radioObj.value;
  } else {
    for (var i = 0; i < radioLength; i++) {
      if(radioObj[i].checked) {
        regId = radioObj[i].value; 
        break;
      }
     }
   }
   var regType = document.getElementById('regType').value;
